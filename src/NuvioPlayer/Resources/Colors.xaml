<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Dark Theme Color Palette -->
    <Color x:Key="ColorBackground">#0B0D11</Color>
    <Color x:Key="ColorBackgroundElevated">#13171F</Color>
    <Color x:Key="ColorSurface">#171B24</Color>
    <Color x:Key="ColorSurfaceHover">#222733</Color>
    <Color x:Key="ColorSurfaceActive">#2D3342</Color>
    <Color x:Key="ColorSurfaceBorder">#262B36</Color>
    <Color x:Key="ColorSurfaceBorderSubtle">#1D212B</Color>

    <!-- Overlay & HUD Colors -->
    <Color x:Key="ColorHudBackground">#D00F1218</Color>
    <Color x:Key="ColorHudBorder">#402F374A</Color>
    <Color x:Key="ColorOsdBackground">#E013171F</Color>

    <!-- Accent & Brand Colors -->
    <Color x:Key="ColorAccent">#38BDF8</Color>           <!-- Vibrant Nuvio Sky Blue -->
    <Color x:Key="ColorAccentHover">#0EA5E9</Color>
    <Color x:Key="ColorAccentActive">#0284C7</Color>
    <Color x:Key="ColorAccentSubtle">#1E293B</Color>

    <!-- Typography Colors -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextDisabled">#475569</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="ColorSuccess">#22C55E</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorError">#EF4444</Color>
    <Color x:Key="ColorInfo">#38BDF8</Color>

    <!-- Window Title Bar Colors -->
    <Color x:Key="ColorTitleBar">#0B0D11</Color>
    <Color x:Key="ColorCloseButtonHover">#DC2626</Color>

</ResourceDictionary>
