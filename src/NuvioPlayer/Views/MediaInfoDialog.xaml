<Window x:Class="NuvioPlayer.Views.MediaInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NuvioPlayer.Models"
        mc:Ignorable="d"
        Title="Media Information — Nuvio Player"
        Icon="/Assets/app.ico"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BrushSurfaceElevated}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar -->
                <RowDefinition Height="46"/>
                <!-- Details Content -->
                <RowDefinition Height="*"/>
                <!-- Bottom Action -->
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseDown="OnTitleBarMouseDown">
                <Grid Margin="18,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                            <Path Fill="{StaticResource BrushAccent}" Data="{StaticResource IconInfo}"/>
                        </Viewbox>
                        <TextBlock Text="Media Information"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnCloseClick"
                            ToolTip="Close">
                        <Viewbox Width="10" Height="10">
                            <Path Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconWindowClose}"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Details Scrollable Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,10">
                <StackPanel>
                    <!-- General Section -->
                    <TextBlock Text="GENERAL"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Container" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Container}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormattedDuration}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormattedFileSize}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Location" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FilePath}" Foreground="{StaticResource BrushTextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>
                        </Grid>
                    </Border>

                    <!-- Video Stream Section -->
                    <TextBlock Text="VIDEO STREAM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Codec" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VideoCodec}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResolutionText}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame Rate" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FrameRateText}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>
                        </Grid>
                    </Border>

                    <!-- Audio Stream Section -->
                    <TextBlock Text="AUDIO STREAM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Codec" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioCodec}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Channels" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioChannelsText}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Rate" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AudioSampleRateText}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Audio Tracks" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AudioTracksSummary}" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,3"/>
                        </Grid>
                    </Border>

                    <!-- Subtitles Section -->
                    <TextBlock Text="SUBTITLES"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tracks" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3"/>
                            <TextBlock Grid.Column="1" Text="{Binding SubtitlesSummary}" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,3"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Button Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy Details"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnCopyClick"
                            Margin="0,0,10,0"/>
                    <Button Content="Close"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnCloseClick"
                            Width="80"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
