<Window x:Class="NuvioPlayer.Views.StreamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:NuvioPlayer.Converters"
        xmlns:models="clr-namespace:NuvioPlayer.Models"
        mc:Ignorable="d"
        Title="Explore &amp; Stream Online — Nuvio Player"
        Icon="pack://application:,,,/NuvioPlayer;component/Assets/app.ico"
        Width="1060" Height="720"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Outer Window Chrome Border with Drop Shadow -->
    <Border Background="{StaticResource BrushSurfaceElevated}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar (48px) -->
                <RowDefinition Height="48"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
                <!-- Bottom Status Bar (36px) -->
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom TitleBar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseDown="OnTitleBarMouseDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Path Fill="{StaticResource BrushAccent}" Data="{StaticResource IconStream}"/>
                        </Viewbox>
                        <TextBlock Text="Explore &amp; Stream Online"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushSurfaceActive}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="LibVLC Direct Stream"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushAccent}"/>
                        </Border>
                    </StackPanel>

                    <!-- Draggable Center Space -->
                    <Grid Grid.Column="1"/>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize">
                            <Viewbox Width="10" Height="10">
                                <Path Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconWindowMinimize}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource TitleBarButton}"
                                Click="OnMaximizeClick"
                                ToolTip="Maximize / Restore">
                            <Viewbox Width="10" Height="10">
                                <Path x:Name="MaximizeIconPath" Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconWindowMaximize}"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}"
                                Command="{Binding CloseCommand}"
                                ToolTip="Close">
                            <Viewbox Width="10" Height="10">
                                <Path Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconWindowClose}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Body Content Area -->
            <Grid Grid.Row="1">
                <!-- VIEW A: Catalog & Search Browser (Visible when SelectedItem == null) -->
                <Grid Visibility="{Binding SelectedItem, Converter={StaticResource InverseNullToVisConverter}}">
                    <Grid.RowDefinitions>
                        <!-- Top Filter & Search Bar (60px) -->
                        <RowDefinition Height="60"/>
                        <!-- Loading Indicator Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Catalog Posters Grid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Filter & Search Bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Category Switcher Tabs -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Search Box -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Category Tabs -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="trending"
                                        Margin="0,0,8,0"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔥 Trending" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="movies"
                                        Margin="0,0,8,0"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                            <Path Fill="{StaticResource BrushTextPrimary}" Data="{StaticResource IconMovie}"/>
                                        </Viewbox>
                                        <TextBlock Text="Movies" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="tv"
                                        Margin="0,0,16,0"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                            <Path Fill="{StaticResource BrushTextPrimary}" Data="{StaticResource IconTv}"/>
                                        </Viewbox>
                                        <TextBlock Text="TV Series" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Search Input & Button -->
                            <Grid Grid.Column="1" HorizontalAlignment="Right" Width="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SearchBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnSearchBoxKeyDown"
                                         Padding="10,6"
                                         ToolTip="Type movie or TV show name"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SearchCommand}"
                                        Margin="8,0,0,0"
                                        Padding="14,6"
                                        ToolTip="Search">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                            <Path Fill="#0F172A" Data="{StaticResource IconSearch}"/>
                                        </Viewbox>
                                        <TextBlock Text="Search" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearSearchCommand}"
                                        Margin="6,0,0,0"
                                        Padding="10,6"
                                        ToolTip="Clear Search">
                                    <Viewbox Width="10" Height="10">
                                        <Path Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconWindowClose}"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Loading Progress Bar -->
                    <ProgressBar Grid.Row="1"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Foreground="{StaticResource BrushAccent}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Scrollable Poster Cards Grid -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,16">
                        <ItemsControl ItemsSource="{Binding CatalogItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MediaCatalogItem}">
                                    <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Margin="8,10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="CardBorder"
                                                        Width="180" Height="305"
                                                        Background="{StaticResource BrushSurface}"
                                                        BorderBrush="{StaticResource BrushBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="240"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Poster Image -->
                                                        <Grid Grid.Row="0" Background="#131C2E">
                                                            <Image Source="{Binding PosterUrl}"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                            <!-- Top Left: Media Type Pill -->
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="8"
                                                                    Background="#CC0F172A"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding MediaType, StringFormat={}{0:U}}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource BrushAccent}"/>
                                                            </Border>

                                                            <!-- Top Right: Rating Pill -->
                                                            <Border HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="8"
                                                                    Background="#D90F172A"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                                                        <Path Fill="#F59E0B" Data="{StaticResource IconStar}"/>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding VoteAverage, StringFormat={}{0:F1}}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#F8FAFC"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Bottom Title & Release Info -->
                                                        <Border Grid.Row="1"
                                                                Background="{StaticResource BrushSurface}"
                                                                Padding="10,8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ReleaseYear}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW B: Details & Stream Selection View (Visible when SelectedItem != null) -->
                <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisConverter}}"
                      Background="{StaticResource BrushSurfaceElevated}">
                    <Grid.RowDefinitions>
                        <!-- Navigation Header with Back Button (50px) -->
                        <RowDefinition Height="50"/>
                        <!-- Details & Streams Content Area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Back Navigation Bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BackToCatalogCommand}"
                                        Padding="12,6"
                                        Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="← Back to Catalog" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SelectedItem.Title}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedItem.ReleaseYear, StringFormat={} ({0})}"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Details & Streams Area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20">
                            <!-- Hero Backdrop & Details Card -->
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Poster (200px) -->
                                        <ColumnDefinition Width="180"/>
                                        <!-- Title, Overview, Metadata -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Poster -->
                                    <Border Grid.Column="0"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            Height="260"
                                            VerticalAlignment="Top">
                                        <Image Source="{Binding SelectedItem.PosterUrl}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Details Column -->
                                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                                        <!-- Title -->
                                        <TextBlock Text="{Binding SelectedItem.Title}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap"/>

                                        <!-- Metadata Row (Year, Rating, Type) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                                            <Border Background="{StaticResource BrushSurfaceActive}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding SelectedItem.MediaType, StringFormat={}{0:U}}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushAccent}"/>
                                            </Border>
                                            <Border Background="#20F59E0B"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                                        <Path Fill="#F59E0B" Data="{StaticResource IconStar}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding SelectedItem.VoteAverage, StringFormat={}{0:F1} / 10}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#F59E0B"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedItem.ReleaseYear}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Plot Summary -->
                                        <TextBlock Text="Overview"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SelectedItem.Overview}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   MaxHeight="120"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- If TV Show: Season and Episode Selectors -->
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding SelectedItem.MediaType, Converter={StaticResource NullToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="SEASONS &amp; EPISODES"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}"
                                               Margin="0,0,0,12"/>

                                    <!-- Seasons Chips -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                                        <ItemsControl ItemsSource="{Binding Seasons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TvSeason}">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.SelectSeasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,8,0"
                                                            Padding="14,6">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Episodes List -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Episodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TvEpisode}">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.SelectEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,8,0"
                                                            Padding="12,8"
                                                            Width="200"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding EpisodeCode}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource BrushAccent}"/>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Direct Video Streams Section -->
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="AVAILABLE DIRECT STREAMS"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAccent}"/>
                                            <TextBlock Text="Hardware-accelerated Direct HTTP playback in Nuvio Player"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1"
                                                     IsIndeterminate="True"
                                                     Width="80" Height="4"
                                                     Foreground="{StaticResource BrushAccent}"
                                                     Visibility="{Binding IsStreamsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                                    </Grid>

                                    <!-- Streams List -->
                                    <ItemsControl ItemsSource="{Binding AvailableStreams}"
                                                  Visibility="{Binding HasStreams, Converter={StaticResource BoolToVisConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:DirectStreamSource}">
                                                <Border Background="{StaticResource BrushSurfaceElevated}"
                                                        BorderBrush="{StaticResource BrushBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="16,12"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Quality Badge -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Stream Details -->
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- Play Button -->
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Quality Badge -->
                                                        <Border Grid.Column="0"
                                                                Background="{StaticResource BrushSurfaceActive}"
                                                                CornerRadius="6"
                                                                Padding="10,6"
                                                                Margin="0,0,14,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quality}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource BrushAccent}"/>
                                                        </Border>

                                                        <!-- Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="14"
                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding Format}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                                                <TextBlock Text=" • "
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                                                <TextBlock Text="{Binding SizeText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Play Button -->
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding DataContext.PlayStreamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="16,8"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                                                                    <Path Fill="#0F172A" Data="{StaticResource IconPlay}"/>
                                                                </Viewbox>
                                                                <TextBlock Text="Play in Nuvio Player" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Resolving Streams State -->
                                    <Border Visibility="{Binding IsStreamsLoading, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{StaticResource BrushSurfaceElevated}"
                                            CornerRadius="8"
                                            Padding="24"
                                            Margin="0,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Resolving direct streaming sources from Stremio &amp; HTTP providers..."
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Querying 4K / 1080p / 720p streams for instant LibVLC playback"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Online Stream Player Card -->
                                    <Border Visibility="{Binding HasNoStreams, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{StaticResource BrushSurfaceElevated}"
                                            BorderBrush="{StaticResource BrushSurfaceBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                                            <Path Fill="{StaticResource BrushAccent}" Data="{StaticResource IconStream}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="ONLINE STREAM AVAILABLE"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushAccent}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Stream high quality video directly inside Nuvio Player with built-in popup ad blocking."
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding OpenInBrowserCommand}"
                                                            Margin="0,0,8,0"
                                                            Padding="12,7"
                                                            ToolTip="Open in external web browser">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                                                <Path Fill="{StaticResource BrushTextSecondary}" Data="{StaticResource IconExternalLink}"/>
                                                            </Viewbox>
                                                            <TextBlock Text="Open in Browser" FontSize="11"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource PrimaryButton}"
                                                            Command="{Binding PlayEmbedFallbackCommand}"
                                                            Padding="16,8"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                                                                <Path Fill="#0F172A" Data="{StaticResource IconPlay}"/>
                                                            </Viewbox>
                                                            <TextBlock Text="Play in Nuvio Player" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Provider Selector Bar -->
                                            <Border Background="{StaticResource BrushSurface}"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Stream Server:"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding SelectProviderCommand}"
                                                                CommandParameter="vidlink"
                                                                Margin="0,0,6,0"
                                                                Padding="10,4"
                                                                ToolTip="Fast JWPlayer CDN with multi-subtitles">
                                                            <TextBlock Text="⚡ VidLink (Fast)" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding SelectProviderCommand}"
                                                                CommandParameter="superembed"
                                                                Margin="0,0,6,0"
                                                                Padding="10,4"
                                                                ToolTip="MultiEmbed direct stream">
                                                            <TextBlock Text="SuperEmbed" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding SelectProviderCommand}"
                                                                CommandParameter="vidsrc"
                                                                Margin="0,0,6,0"
                                                                Padding="10,4"
                                                                ToolTip="VidSrc v3 backup server">
                                                            <TextBlock Text="VidSrc v3" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding SelectProviderCommand}"
                                                                CommandParameter="vidking"
                                                                Padding="10,4"
                                                                ToolTip="VidKing server">
                                                            <TextBlock Text="VidKing" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 3. Bottom Status Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Nuvio Player • Direct3D11 Hardware Rendering"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
